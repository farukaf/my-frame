<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="MyFrame.App.Components.SyncStatus" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid IsVisible="{Binding IsVisible}" RowDefinitions="Auto,Auto,Auto,*,180" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="Synchronization status" Style="{DynamicResource Title}" />
                <Label Text="Read-only health of the shared SQLite data store used by My Frame and MCP." TextColor="#8995A8" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Refresh status" Command="{Binding RefreshSyncStatusCommand}" BackgroundColor="#167C70" TextColor="White" />
        </Grid>
        <Border Grid.Row="1" Style="{DynamicResource Card}" Padding="12">
            <HorizontalStackLayout Spacing="8">
                <ActivityIndicator IsRunning="{Binding IsLoadingSyncStatus}" IsVisible="{Binding IsLoadingSyncStatus}" Color="#7DE2D1" WidthRequest="16" />
                <Label Text="{Binding SyncStatusMessage}" Style="{DynamicResource Muted}" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Border>
        <Border Grid.Row="2" Style="{DynamicResource Card}" Padding="12">
            <VerticalStackLayout Spacing="8">
                <Label Text="Overwolf capture inbox" Style="{DynamicResource SectionTitle}" />
                <Label Text="Copie os .capture.json e .ready.json exportados pelo coletor para esta pasta." Style="{DynamicResource Muted}" />
                <Entry Text="{Binding CollectorCaptureDirectory}" IsReadOnly="True" TextColor="#F4F7FB" BackgroundColor="#20283A" />
                <HorizontalStackLayout Spacing="10">
                    <CheckBox IsChecked="{Binding AllowCollectorRawPayload}" Color="#7DE2D1" />
                    <Label Text="Autorizar a leitura do payload privado desta importação" Style="{DynamicResource Muted}" VerticalOptions="Center" />
                    <Button Text="Importar capturas" Command="{Binding ImportCollectorCapturesCommand}" BackgroundColor="#167C70" TextColor="White" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsImportingCollectorCaptures}" IsVisible="{Binding IsImportingCollectorCaptures}" Color="#7DE2D1" WidthRequest="16" />
                    <Label Text="{Binding CollectorCaptureMessage}" Style="{DynamicResource Muted}" VerticalOptions="Center" />
                    <Label Text="{Binding CollectorCaptureNotice}" TextColor="#F4C76D" IsVisible="{Binding CollectorCaptureNoticeVisible}" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Sync World State" Command="{Binding SyncWorldStateCommand}" BackgroundColor="#167C70" TextColor="White" />
                    <ActivityIndicator IsRunning="{Binding IsSyncingWorldState}" IsVisible="{Binding IsSyncingWorldState}" Color="#7DE2D1" WidthRequest="16" />
                    <Label Text="{Binding WorldStateSyncMessage}" Style="{DynamicResource Muted}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Sync Public Export" Command="{Binding SyncPublicExportCommand}" BackgroundColor="#167C70" TextColor="White" />
                    <ActivityIndicator IsRunning="{Binding IsSyncingPublicExport}" IsVisible="{Binding IsSyncingPublicExport}" Color="#7DE2D1" WidthRequest="16" />
                    <Label Text="{Binding PublicExportSyncMessage}" Style="{DynamicResource Muted}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="3" ItemsSource="{Binding SyncSources}" SelectionMode="None">
            <CollectionView.EmptyView><Label Text="No synchronization sources registered." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,8" Padding="14">
                        <Grid ColumnDefinitions="2*,*,2*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                            <Label Text="{Binding DisplayName}" TextColor="#F4F7FB" FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1" Text="{Binding State}" TextColor="#7DE2D1" />
                            <Label Grid.Column="2" Text="{Binding LastRun}" Style="{DynamicResource Muted}" HorizontalTextAlignment="End" />
                            <Label Grid.Row="1" Text="{Binding Detail}" Style="{DynamicResource Muted}" />
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Revision, StringFormat='Revision: {0}'}" Style="{DynamicResource Muted}" HorizontalTextAlignment="End" />
                            <Label Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding ParserVersion, StringFormat='Parser: {0}'}" Style="{DynamicResource Muted}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Border Grid.Row="4" Style="{DynamicResource Card}" Padding="12">
            <VerticalStackLayout Spacing="6">
                <Label Text="Recent synchronization attempts" Style="{DynamicResource SectionTitle}" />
                <CollectionView ItemsSource="{Binding SyncAttempts}" SelectionMode="None">
                    <CollectionView.EmptyView><Label Text="No synchronization attempts recorded." Style="{DynamicResource Muted}" /></CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="2*,*,2*" ColumnSpacing="10" Padding="0,2">
                                <Label Text="{Binding SourceId}" Style="{DynamicResource Muted}" />
                                <Label Grid.Column="1" Text="{Binding State}" TextColor="#7DE2D1" />
                                <Label Grid.Column="2" Text="{Binding Detail}" Style="{DynamicResource Muted}" HorizontalTextAlignment="End" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="MyFrame.App.Components.Sales" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:MyFrame.App.Components">
    <Grid IsVisible="{Binding IsVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><Label Text="Sales and ducats" Style="{StaticResource Title}"/><Entry Grid.Column="1" Style="{StaticResource SearchField}" Placeholder="Search sales…" Text="{Binding SearchText}" WidthRequest="220"/><Grid Grid.Column="2" HeightRequest="40" WidthRequest="190"><Border BackgroundColor="#20283A" Stroke="#3A455B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="0"/><Picker Style="{StaticResource SelectField}" Title="" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" BackgroundColor="Transparent" Margin="4,3,4,0"/><Label Text="Goal" FontSize="10" TextColor="#AEB8C8" BackgroundColor="#20283A" Padding="3,0" Margin="9,0,0,0" HorizontalOptions="Start" VerticalOptions="Start"/></Grid><Grid Grid.Column="3" HeightRequest="40" WidthRequest="150"><Border BackgroundColor="#20283A" Stroke="#3A455B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="0"/><Picker Style="{StaticResource SelectField}" Title="" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" BackgroundColor="Transparent" Margin="4,3,4,0"/><Label Text="Sort" FontSize="10" TextColor="#AEB8C8" BackgroundColor="#20283A" Padding="3,0" Margin="9,0,0,0" HorizontalOptions="Start" VerticalOptions="Start"/></Grid></Grid>
        <Border Grid.Row="1" BackgroundColor="#151A23" Stroke="#252D3A" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><components:DucatConversion/><HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" ToolTipProperties.Text="Vaulted parts cannot be farmed again, so they are often worth holding rather than selling"><HorizontalStackLayout.GestureRecognizers><TapGestureRecognizer Command="{Binding ToggleVaultedPartsCommand}"/></HorizontalStackLayout.GestureRecognizers><CheckBox IsChecked="{Binding IncludeVaultedParts}" Color="#7DE2D1" VerticalOptions="Center"/><Label Text="Include vaulted parts" TextColor="#D6DCE6" FontSize="13" VerticalOptions="Center"/></HorizontalStackLayout></Grid></Border>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No extras available." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}" Badge="{Binding VaultStatus}" OwnedBadge="{Binding CardOwned}" Metadata="{Binding CardMetadata}" Action="{Binding ActionLabel}" Description="{Binding Reason}" IsMastered="{Binding Mastered}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" /></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </Grid>
</ContentView>

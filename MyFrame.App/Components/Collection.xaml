<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="MyFrame.App.Components.Collection" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:MyFrame.App.Components">
    <Grid IsVisible="{Binding IsVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><VerticalStackLayout><Label Text="Collection and mastery" Style="{StaticResource Title}"/><Label Text="Items with active progress are shown by default." TextColor="#8995A8"/></VerticalStackLayout><HorizontalStackLayout Grid.Column="1" Spacing="8"><Entry Style="{StaticResource SearchField}" Placeholder="Search collection…" Text="{Binding SearchText}" WidthRequest="190"/><Picker Style="{StaticResource SelectField}" Title="Filter" ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" WidthRequest="145"/><Picker Style="{StaticResource SelectField}" Title="Sort" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" WidthRequest="190"/></HorizontalStackLayout></Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No collection items loaded." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}" Badge="{Binding PrimeStatus}" Metadata="{Binding CardMetadata}" Action="{Binding Status}" Progress="{Binding Completion}" ShowProgress="True" IsMastered="{Binding Mastered}" IsOwned="{Binding Owned}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" Components="{Binding Components}" ShowDetailsButton="True" /></DataTemplate></CollectionView.ItemTemplate></CollectionView>
    </Grid>
</ContentView>

<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MyFrame.App.Components.RecommendationCard"
    x:Name="CardRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Border BackgroundColor="#151A23" Stroke="#252D3A" StrokeThickness="1"
            StrokeShape="RoundRectangle 14" Padding="12" MinimumHeightRequest="142">
        <Grid ColumnDefinitions="74,*" RowDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10" RowSpacing="5">
            <Border WidthRequest="68" HeightRequest="68" BackgroundColor="#0D121C"
                    Stroke="#303B50" StrokeShape="RoundRectangle 8" Padding="4">
                <Image Source="{Binding ImageUrl, Source={x:Reference CardRoot}}" Aspect="AspectFit" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2">
                <Label Text="{Binding Title, Source={x:Reference CardRoot}}" TextColor="#F4F7FB"
                       FontFamily="OpenSansSemibold" LineBreakMode="TailTruncation" />
                <Label Text="{Binding Badge, Source={x:Reference CardRoot}}" TextColor="#F3C969" FontSize="11" />
                <Label Text="{Binding Metadata, Source={x:Reference CardRoot}}" TextColor="#8995A8"
                       FontSize="12" LineBreakMode="TailTruncation" />
            </VerticalStackLayout>
            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Action, Source={x:Reference CardRoot}}"
                   TextColor="#F3C969" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap" />
            <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Description, Source={x:Reference CardRoot}}"
                   TextColor="#8995A8" FontSize="12" LineBreakMode="WordWrap" />
            <ProgressBar Grid.Row="3" Grid.ColumnSpan="2"
                         IsVisible="{Binding ShowProgress, Source={x:Reference CardRoot}}"
                         Progress="{Binding Progress, Source={x:Reference CardRoot}}"
                         ProgressColor="#7D3CFF" BackgroundColor="#273149" HeightRequest="5" Margin="0,4,0,0" />
        </Grid>
    </Border>
</ContentView>

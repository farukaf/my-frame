<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="MyFrame.App.Components.Farm" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:components="clr-namespace:MyFrame.App.Components">
    <Grid IsVisible="{Binding IsVisible}" RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><Label Text="Farm plan" Style="{DynamicResource Title}"/><Entry Grid.Column="1" Style="{DynamicResource SearchField}" Placeholder="Search farm…" Text="{Binding SearchText}" WidthRequest="220"/></Grid><CollectionView Grid.Row="1" ItemsSource="{Binding Items}" SelectionMode="None"><CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout><CollectionView.EmptyView><Label Text="No farming recommendations right now." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}" Badge="{Binding VaultStatus}" Metadata="{Binding CardMetadata}" Action="{Binding CardAction}" Description="{Binding Reason}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" /></DataTemplate></CollectionView.ItemTemplate></CollectionView></Grid>
</ContentView>

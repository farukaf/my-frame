<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyFrame.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:MyFrame.App.Components"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#0B0E14">

    <ContentPage.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#AEB8C8" />
            <Setter Property="HorizontalOptions" Value="Fill" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style x:Key="NavItem" TargetType="Border">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#151A23" />
            <Setter Property="Stroke" Value="#252D3A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="Title" TargetType="Label">
            <Setter Property="TextColor" Value="#F4F7FB" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="26" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#F4F7FB" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="#8995A8" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SearchField" TargetType="Entry">
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="#20283A" />
            <Setter Property="TextColor" Value="#F4F7FB" />
            <Setter Property="PlaceholderColor" Value="#8995A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="SelectField" TargetType="Picker">
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="BackgroundColor" Value="#20283A" />
            <Setter Property="TextColor" Value="#F4F7FB" />
            <Setter Property="TitleColor" Value="#8995A8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="220,*" RowDefinitions="*">
        <Border Grid.Column="0" BackgroundColor="#10141C" StrokeThickness="0" Padding="18,24">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="22">
                <VerticalStackLayout Spacing="2">
                    <Label Text="MY FRAME" TextColor="#7DE2D1" FontFamily="OpenSansSemibold" FontSize="22" />
                    <Label Text="Warframe companion" Style="{StaticResource Muted}" />
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="5">
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Dashboard" /></Border.GestureRecognizers><Label Text="⌂  Dashboard" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Collection" /></Border.GestureRecognizers><Label Text="◉  Collection" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Farm" /></Border.GestureRecognizers><Label Text="◇  Farm plan" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Relics" /></Border.GestureRecognizers><Label Text="⬡  Relic advisor" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Sales" /></Border.GestureRecognizers><Label Text="⇄  Sales and ducats" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Surplus" /></Border.GestureRecognizers><Label Text="⊖  Surplus" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="SyncStatus" /></Border.GestureRecognizers><Label Text="◌  Sync status" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                    <Border Style="{StaticResource NavItem}"><Border.GestureRecognizers><TapGestureRecognizer Command="{Binding ShowSectionCommand}" CommandParameter="Settings" /></Border.GestureRecognizers><Label Text="⚙  Settings" TextColor="#AEB8C8" HorizontalOptions="Start" /></Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="3" Spacing="4">
                    <Label Text="{Binding AccountText}" TextColor="#D6DCE6" FontSize="12" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding StatusMessage}" Style="{StaticResource Muted}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding LastSyncText, StringFormat='MyFrame refreshed: {0}'}" Style="{StaticResource Muted}" />
                    <Label Text="{Binding AlecaDataUpdatedText, StringFormat='Aleca data: {0}'}" Style="{StaticResource Muted}" />

                    <VerticalStackLayout Spacing="5" Margin="0,6,0,0" IsVisible="{Binding IsSyncingPrices}">
                        <HorizontalStackLayout Spacing="7">
                            <ActivityIndicator IsRunning="{Binding IsSyncingPrices}" Color="#7DE2D1"
                                               WidthRequest="13" HeightRequest="13" VerticalOptions="Center" />
                            <Label Text="{Binding SyncProgressText}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding SyncProgress}" ProgressColor="#7DE2D1"
                                     BackgroundColor="#273149" HeightRequest="4" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding PricesStale}" BackgroundColor="#3A2328" StrokeThickness="0"
                            StrokeShape="RoundRectangle 6" Padding="8,5" Margin="0,6,0,0">
                        <Label Text="{Binding StaleWarningText}" TextColor="#FF9A9A" FontSize="11" LineBreakMode="WordWrap" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" Padding="28,22" RowSpacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <VerticalStackLayout Spacing="2">
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Smart inventory" Style="{StaticResource Title}" />
                        <Button Text="↗" Command="{Binding OpenWikiCommand}" ToolTipProperties.Text="Open Warframe Wiki" BackgroundColor="Transparent" TextColor="#7DE2D1" FontSize="19" Padding="4,0" />
                    </HorizontalStackLayout>
                    <Label Text="Collection, farming, relics, and the value of your extras in one place." TextColor="#8995A8" />
                </VerticalStackLayout>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <HorizontalStackLayout IsVisible="{Binding SalesVisible}" Spacing="8">
                        <Border Padding="9,6" BackgroundColor="#151A23" Stroke="#303B50" StrokeShape="RoundRectangle 8"
                                ToolTipProperties.Text="Ducats the rows currently listed would return">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="ESTIMATE" TextColor="#8995A8" FontSize="9" VerticalOptions="Center" />
                                <Label Text="{Binding FilteredDucatsEstimate}" TextColor="#F3C969"
                                       FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                                <Image Source="ducats.svg" WidthRequest="17" HeightRequest="17" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border Padding="9,6" BackgroundColor="#151A23" Stroke="#303B50" StrokeShape="RoundRectangle 8">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="KEEP PRIME SETS" TextColor="#AEB8C8" FontSize="10" VerticalOptions="Center" />
                                <Border Padding="6,2" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding ActivePrimeSetReserveEnabled}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#173F35" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding ActivePrimeSetReserveEnabled}" Value="False">
                                            <Setter Property="BackgroundColor" Value="#3A2328" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding ActivePrimeSetReserveText}" FontFamily="OpenSansSemibold" FontSize="10">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding ActivePrimeSetReserveEnabled}" Value="True">
                                                <Setter Property="TextColor" Value="#7DE2D1" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding ActivePrimeSetReserveEnabled}" Value="False">
                                                <Setter Property="TextColor" Value="#FF9A9A" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                    <Border IsVisible="{Binding SurplusVisible}" Padding="9,6" BackgroundColor="#151A23" Stroke="#303B50"
                            StrokeShape="RoundRectangle 8" VerticalOptions="Center"
                            ToolTipProperties.Text="Copies you no longer need, across the rows currently listed">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="SURPLUS" TextColor="#8995A8" FontSize="9" VerticalOptions="Center" />
                            <Label Text="{Binding SurplusSummary}" TextColor="#F3C969"
                                   FontFamily="OpenSansSemibold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#7DE2D1" />
                    <Button Grid.Column="2" Text="Refresh now" Command="{Binding RefreshCommand}" BackgroundColor="#167C70" TextColor="White" />
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollView IsVisible="{Binding DashboardVisible}">
                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <Border Style="{StaticResource Card}"><VerticalStackLayout><Label Text="ESTIMATED PLATINUM" Style="{StaticResource Muted}"/><Label Text="{Binding TotalPlatinum}" TextColor="#7DE2D1" FontSize="26" FontFamily="OpenSansSemibold"/></VerticalStackLayout></Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="AVAILABLE DUCATS" Style="{StaticResource Muted}"/><Label Text="{Binding TotalDucats}" TextColor="#F3C969" FontSize="26" FontFamily="OpenSansSemibold"/></VerticalStackLayout></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="MASTERY" Style="{StaticResource Muted}"/><Label Text="{Binding MasteryProgress}" TextColor="#B9A7FF" FontSize="26" FontFamily="OpenSansSemibold"/></VerticalStackLayout></Border>
                            <Border Grid.Column="3" Style="{StaticResource Card}"><VerticalStackLayout><Label Text="INVENTORY" Style="{StaticResource Muted}"/><Label Text="{Binding InventorySummary}" TextColor="#F4F7FB" FontSize="16" FontFamily="OpenSansSemibold" LineBreakMode="WordWrap"/></VerticalStackLayout></Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Border Style="{StaticResource Card}">
                                <Grid RowDefinitions="Auto,260">
                                    <Label Text="Extra inventory value" Style="{StaticResource SectionTitle}" />
                                    <lvc:PieChart Grid.Row="1" Series="{Binding ValueSeries}" LegendPosition="Bottom" />
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Card}">
                                <Grid RowDefinitions="Auto,260">
                                    <Label Text="Mastery progress" Style="{StaticResource SectionTitle}" />
                                    <lvc:CartesianChart Grid.Row="1" Series="{Binding ProgressSeries}" LegendPosition="Bottom" />
                                </Grid>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid IsVisible="{Binding SyncStatusVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Synchronization status" Style="{StaticResource Title}" />
                            <Label Text="Read-only health of the shared SQLite data store used by My Frame and MCP." TextColor="#8995A8" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="Refresh status" Command="{Binding RefreshSyncStatusCommand}" BackgroundColor="#167C70" TextColor="White" />
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <HorizontalStackLayout Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsLoadingSyncStatus}" IsVisible="{Binding IsLoadingSyncStatus}" Color="#7DE2D1" WidthRequest="16" />
                            <Label Text="{Binding SyncStatusMessage}" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding SyncSources}" SelectionMode="None">
                        <CollectionView.EmptyView><Label Text="No synchronization sources registered." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14">
                                    <Grid ColumnDefinitions="2*,*,2*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                                        <Label Text="{Binding DisplayName}" TextColor="#F4F7FB" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding State}" TextColor="#7DE2D1" />
                                        <Label Grid.Column="2" Text="{Binding LastRun}" Style="{StaticResource Muted}" HorizontalTextAlignment="End" />
                                        <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Revision, StringFormat='Revision: {0}'}" Style="{StaticResource Muted}" HorizontalTextAlignment="End" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding CollectionVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout><Label Text="Collection and mastery" Style="{StaticResource Title}"/><Label Text="Items with active progress are shown by default." TextColor="#8995A8"/></VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8">
                            <Entry Style="{StaticResource SearchField}" Placeholder="Search collection…" Text="{Binding CollectionSearchText}" WidthRequest="190" />
                            <Picker Style="{StaticResource SelectField}" Title="Filter" ItemsSource="{Binding CollectionFilters}" SelectedItem="{Binding SelectedCollectionFilter}" WidthRequest="145" />
                            <Picker Style="{StaticResource SelectField}" Title="Sort" ItemsSource="{Binding CollectionSorts}" SelectedItem="{Binding SelectedCollectionSort}" WidthRequest="190" />
                        </HorizontalStackLayout>
                    </Grid>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Collection}" SelectionMode="None">
                        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.EmptyView><Label Text="No collection items loaded." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate>
                            <components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}"
                                Badge="{Binding PrimeStatus}" Metadata="{Binding CardMetadata}" Action="{Binding Status}"
                                Progress="{Binding Completion}" ShowProgress="True" IsMastered="{Binding Mastered}" IsOwned="{Binding Owned}"
                                Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}"
                                Components="{Binding Components}" ShowDetailsButton="True" />
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding FarmVisible}" RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Label Text="Farm plan" Style="{StaticResource Title}" />
                        <Entry Grid.Column="1" Style="{StaticResource SearchField}" Placeholder="Search farm…" Text="{Binding FarmSearchText}" WidthRequest="220" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Farm}" SelectionMode="None">
                        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.EmptyView><Label Text="No farming recommendations right now." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate>
                            <components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}"
                                Badge="{Binding VaultStatus}" Metadata="{Binding CardMetadata}" Action="{Binding CardAction}"
                                Description="{Binding Reason}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" />
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding RelicsVisible}" RowDefinitions="Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <VerticalStackLayout>
                            <Label Text="Relic advisor" Style="{StaticResource Title}" />
                            <Label Text="Compares the sealed relic price with the chance-weighted market value of its rewards." TextColor="#8995A8" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" Style="{StaticResource SearchField}" Placeholder="Search relics…" Text="{Binding RelicsSearchText}" WidthRequest="220" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding Relics}" SelectionMode="None">
                        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.EmptyView><Label Text="No owned relics with catalog data were found." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate>
                            <components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding RelicName}"
                                Badge="{Binding VaultStatus}" OwnedBadge="{Binding CardOwned}" Metadata="{Binding CardMetadata}" Action="{Binding Action}"
                                Description="{Binding Reason}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" />
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding SalesVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Sales and ducats" Style="{StaticResource Title}" />
                        <Entry Grid.Column="1" Style="{StaticResource SearchField}" Placeholder="Search sales…" Text="{Binding SalesSearchText}" WidthRequest="220" />
                        <Grid Grid.Column="2" HeightRequest="40" WidthRequest="190">
                            <Border BackgroundColor="#20283A" Stroke="#3A455B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="0" />
                            <Picker Style="{StaticResource SelectField}" Title="" ItemsSource="{Binding SalesFilters}" SelectedItem="{Binding SelectedSalesFilter}" BackgroundColor="Transparent" Margin="4,3,4,0" />
                            <Label Text="Goal" FontSize="10" TextColor="#AEB8C8" BackgroundColor="#20283A" Padding="3,0" Margin="9,0,0,0" HorizontalOptions="Start" VerticalOptions="Start" />
                        </Grid>
                        <Grid Grid.Column="3" HeightRequest="40" WidthRequest="150">
                            <Border BackgroundColor="#20283A" Stroke="#3A455B" StrokeThickness="1" StrokeShape="RoundRectangle 4" Padding="0" />
                            <Picker Style="{StaticResource SelectField}" Title="" ItemsSource="{Binding SalesSorts}" SelectedItem="{Binding SelectedSalesSort}" BackgroundColor="Transparent" Margin="4,3,4,0" />
                            <Label Text="Sort" FontSize="10" TextColor="#AEB8C8" BackgroundColor="#20283A" Padding="3,0" Margin="9,0,0,0" HorizontalOptions="Start" VerticalOptions="Start" />
                        </Grid>
                    </Grid>
                    <!-- The ratio sits above the list it reorders, so a drag shows its effect at once. -->
                    <Border Grid.Row="1" BackgroundColor="#151A23" Stroke="#252D3A" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="14,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <components:DucatConversion />
                            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"
                                                   ToolTipProperties.Text="Vaulted parts cannot be farmed again, so they are often worth holding rather than selling">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleVaultedPartsCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <CheckBox IsChecked="{Binding IncludeVaultedParts}" Color="#7DE2D1" VerticalOptions="Center" />
                                <Label Text="Include vaulted parts" TextColor="#D6DCE6" FontSize="13" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Sales}" SelectionMode="None">
                        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.EmptyView><Label Text="No extras available." TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate>
                            <components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}"
                                Badge="{Binding VaultStatus}" OwnedBadge="{Binding CardOwned}" Metadata="{Binding CardMetadata}" Action="{Binding ActionLabel}"
                                Description="{Binding Reason}" IsMastered="{Binding Mastered}"
                                Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" />
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <Grid IsVisible="{Binding SurplusVisible}" RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout>
                            <Label Text="Surplus" Style="{StaticResource Title}" />
                            <Label Text="Parts with nothing left to build: the item is already yours, its mastery is already banked, or only one can ever be used." TextColor="#8995A8" />
                        </VerticalStackLayout>
                        <Entry Grid.Column="1" Style="{StaticResource SearchField}" Placeholder="Search surplus…" Text="{Binding SurplusSearchText}" WidthRequest="220" />
                    </Grid>
                    <!-- Two groups, combined rather than merged: a reason has to be ticked and so does
                         the platinum side, which is what makes "mastered but worth no platinum" askable. -->
                    <Border Grid.Row="1" BackgroundColor="#151A23" Stroke="#252D3A" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="14,10">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="14">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="REASON" TextColor="#8995A8" FontSize="9" VerticalOptions="Center" />
                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center"
                                                       ToolTipProperties.Text="The mastery is already banked, so building it again adds nothing">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSurplusFilterCommand}" CommandParameter="Mastered" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <CheckBox IsChecked="{Binding SurplusShowMastered}" Color="#7DE2D1" VerticalOptions="Center" />
                                    <Label Text="Have mastered" TextColor="#D6DCE6" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center"
                                                       ToolTipProperties.Text="The built item is already in your inventory">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSurplusFilterCommand}" CommandParameter="Crafted" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <CheckBox IsChecked="{Binding SurplusShowCrafted}" Color="#7DE2D1" VerticalOptions="Center" />
                                    <Label Text="Have crafted" TextColor="#D6DCE6" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="2" VerticalOptions="Center"
                                                       ToolTipProperties.Text="Ship segments and landing craft install once per account, so every copy past the first is spare">
                                    <HorizontalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleSurplusFilterCommand}" CommandParameter="OnlyOneNeeded" />
                                    </HorizontalStackLayout.GestureRecognizers>
                                    <CheckBox IsChecked="{Binding SurplusShowOnlyOneNeeded}" Color="#7DE2D1" VerticalOptions="Center" />
                                    <Label Text="Only one needed" TextColor="#D6DCE6" FontSize="13" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                            <BoxView Grid.Column="1" WidthRequest="1" Color="#252D3A" VerticalOptions="Fill" Margin="0,2" />
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Text="PLATINUM" TextColor="#8995A8" FontSize="9" VerticalOptions="Center" Margin="0,0,4,0" />
                                <Border Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        ToolTipProperties.Text="No constraint on platinum value">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSurplusPlatinumCommand}" CommandParameter="Any" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding SurplusPlatinum}" Value="Any">
                                            <Setter Property="BackgroundColor" Value="#173F35" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Any" FontSize="13" VerticalOptions="Center" TextColor="#8995A8">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SurplusPlatinum}" Value="Any">
                                                <Setter Property="TextColor" Value="#7DE2D1" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        ToolTipProperties.Text="Tradable and currently priced on Warframe.Market">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSurplusPlatinumCommand}" CommandParameter="Has value" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding SurplusPlatinum}" Value="Has value">
                                            <Setter Property="BackgroundColor" Value="#173F35" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Has value" FontSize="13" VerticalOptions="Center" TextColor="#8995A8">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SurplusPlatinum}" Value="Has value">
                                                <Setter Property="TextColor" Value="#7DE2D1" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Border Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 6" VerticalOptions="Center"
                                        ToolTipProperties.Text="Untradable, or tradable with no market price — sells in game for credits">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetSurplusPlatinumCommand}" CommandParameter="No value" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding SurplusPlatinum}" Value="No value">
                                            <Setter Property="BackgroundColor" Value="#173F35" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="No value" FontSize="13" VerticalOptions="Center" TextColor="#8995A8">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SurplusPlatinum}" Value="No value">
                                                <Setter Property="TextColor" Value="#7DE2D1" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                            <Button Grid.Column="4" Text="Reset" Command="{Binding ResetSurplusFiltersCommand}"
                                    BackgroundColor="#20283A" TextColor="#AEB8C8" FontSize="12"
                                    Padding="10,0" HeightRequest="30" VerticalOptions="Center"
                                    ToolTipProperties.Text="Tick every filter again" />
                        </Grid>
                    </Border>
                    <CollectionView Grid.Row="2" ItemsSource="{Binding Surplus}" SelectionMode="None">
                        <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" /></CollectionView.ItemsLayout>
                        <CollectionView.EmptyView><Label Text="{Binding SurplusEmptyMessage}" TextColor="#8995A8" Margin="10,30" /></CollectionView.EmptyView>
                        <CollectionView.ItemTemplate><DataTemplate>
                            <components:RecommendationCard ImageUrl="{Binding ImageUrl}" Title="{Binding ItemName}"
                                Badge="{Binding ReasonBadge}" OwnedBadge="{Binding CardOwned}" Metadata="{Binding CardMetadata}" Action="{Binding ActionLabel}"
                                Description="{Binding Explanation}" Details="{Binding ItemDetails}" MarketSlug="{Binding MarketSlug}" ShowDetailsButton="True" />
                        </DataTemplate></CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <ScrollView IsVisible="{Binding SettingsVisible}">
                    <VerticalStackLayout Spacing="16" MaximumWidthRequest="700" HorizontalOptions="Start">
                        <Label Text="Settings" Style="{StaticResource Title}" />
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="AlecaFrame data folder" Style="{StaticResource SectionTitle}" />
                                <Label Text="Choose the folder containing lastData.dat and cachedData/json. The automatic location works for standard installations." TextColor="#8995A8" />
                                <Label Text="My Frame can start without this folder. Configure it here before loading inventory data." TextColor="#F3C969" FontSize="12" />
                                <Entry Text="{Binding AlecaFrameDirectory}" IsReadOnly="True" TextColor="#F4F7FB" BackgroundColor="#20283A" />
                                <Label Text="{Binding AlecaFrameDirectoryMessage}" Style="{StaticResource Muted}" />
                                <HorizontalStackLayout Spacing="10">
                                    <Button Text="Choose folder" Command="{Binding SelectAlecaFrameDirectoryCommand}" BackgroundColor="#167C70" TextColor="White" />
                                    <Button Text="Use automatic location" Command="{Binding ResetAlecaFrameDirectoryCommand}" BackgroundColor="#20283A" TextColor="#D6DCE6" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="14">
                                <Label Text="Ducats / platinum conversion" Style="{StaticResource SectionTitle}" />
                                <Label Text="Sets the threshold used by recommendations. Changes apply immediately." TextColor="#8995A8" />
                                <components:DucatConversion />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Reserve unvaulted Prime sets" TextColor="#F4F7FB" />
                                        <Label Text="Choose how many weapon or Warframe sets to hold for sale after they enter the vault. Use 0 to disable." Style="{StaticResource Muted}" />
                                    </VerticalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Entry Text="{Binding UnvaultedPrimeSetsToReserve, Mode=TwoWay}" Keyboard="Numeric" MaxLength="2"
                                               WidthRequest="52" HeightRequest="40" HorizontalTextAlignment="Center"
                                               TextColor="#F4F7FB" BackgroundColor="#20283A" />
                                        <Label Text="sets" TextColor="#AEB8C8" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="12">
                                <Label Text="AI / MCP" Style="{StaticResource SectionTitle}" />
                                <Label Text="Connect Codex or Claude to the inventory covered by My Frame. The server is local and read-only, but your client may send returned data to its AI provider." TextColor="#8995A8" />
                                <Label Text="Account identity is omitted by default. Prices can be old or incomplete; every response reports its source status and coverage." TextColor="#F3C969" FontSize="12" />
                                <Label Text="Server executable" Style="{StaticResource Muted}" />
                                <Entry Text="{Binding McpExecutablePath}" IsReadOnly="True" TextColor="#F4F7FB" BackgroundColor="#20283A" />
                                <Label Text="Codex" TextColor="#F4F7FB" FontAttributes="Bold" />
                                <Editor Text="{Binding CodexMcpCommand}" IsReadOnly="True" AutoSize="TextChanges"
                                        TextColor="#D6DCE6" BackgroundColor="#20283A" />
                                <Button Text="Copy Codex command" Command="{Binding CopyMcpCommandCommand}"
                                        CommandParameter="Codex" BackgroundColor="#167C70" TextColor="White"
                                        HorizontalOptions="Start" />
                                <Label Text="Claude Code" TextColor="#F4F7FB" FontAttributes="Bold" />
                                <Editor Text="{Binding ClaudeMcpCommand}" IsReadOnly="True" AutoSize="TextChanges"
                                        TextColor="#D6DCE6" BackgroundColor="#20283A" />
                                <Button Text="Copy Claude command" Command="{Binding CopyMcpCommandCommand}"
                                        CommandParameter="Claude" BackgroundColor="#167C70" TextColor="White"
                                        HorizontalOptions="Start" />
                                <Label Text="{Binding McpCopyMessage}" Style="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
